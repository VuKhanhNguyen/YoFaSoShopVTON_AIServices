# AI khong ket noi MySQL. API/worker dung chung RUNTIME_DIR tren mot host.
# Copy thành .env và tự tạo secret; không commit file .env thật.
AI_INTERNAL_API_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_ENV=development
AI_MODE=mock
EMBEDDED_WORKER=true
EXPOSE_DOCS=true
RUNTIME_DIR=./data/runtime
MAX_UPLOAD_BYTES=62914560
MAX_IMAGE_PIXELS=60000000
MIN_IMAGE_SIDE=128
MAX_QUEUE_SIZE=20
RATE_LIMIT_PER_MINUTE=120
MAX_JOB_ATTEMPTS=2
JOB_TIMEOUT_SECONDS=300
VTON_JOB_TIMEOUT_SECONDS=180
VTON_DOWNLOAD_TIMEOUT_SECONDS=60
RETENTION_HOURS=24
MOCK_PERSON_FRAME=full_body
MOCK_CATEGORY=upper_body

# ==============================================================================
# Cloud VTON Provider: đổi model chỉ cần sửa 1 dòng VTON_PROVIDER
# Giá trị hỗ trợ: fashn_v16 | genlook | kling_o1
# ==============================================================================
VTON_PROVIDER=fashn_v16

# --- 1) fal.ai (dùng cho VTON_PROVIDER=fashn_v16 hoặc kling_o1) ---
# Lấy API key tại: https://fal.ai/dashboard/keys
FAL_KEY=CHANGE_ME_FAL_API_KEY
FASHN_ENDPOINT=fal-ai/fashn/tryon/v1.6
KLING_ENDPOINT=fal-ai/kling-image/o1
# mode: quality (~12-19s, nét nhất, cùng giá $0.075) | balanced (~8-12s) | performance (~5-7s)
FASHN_MODE=quality
# garment_photo_type: auto (cutout tự dùng flat-lay, ảnh thường tự nhận diện) | flat-lay | model
FASHN_GARMENT_PHOTO_TYPE=auto
# moderation_level: permissive (khuyên dùng cho shop thời trang) | conservative | none
FASHN_MODERATION_LEVEL=permissive
# segmentation_free: true (không cắt mask cứng, giữ tóc/tay/nền tự nhiên nhất)
FASHN_SEGMENTATION_FREE=true
# Khóa số ảnh sinh mỗi lượt = 1 để tránh nhân chi phí API ($0.075/ảnh)
FASHN_NUM_SAMPLES=1

# --- 2) Genlook (dùng khi đặt VTON_PROVIDER=genlook) ---
# Lấy API key tại: https://platform.genlook.app
GENLOOK_API_KEY=CHANGE_ME_GENLOOK_API_KEY
GENLOOK_BASE_URL=https://api.genlook.app/tryon/v1
# crop=false: TẮT tự cắt 4:5 ảnh khách tải lên (giữ nguyên khung hình gốc)
GENLOOK_CROP=false
# resolution: default (1200px, 1 credit) | 2k (2048px, 2 credits)
GENLOOK_RESOLUTION=default
GENLOOK_WATERMARK=false
GENLOOK_AI_LABEL=false
GENLOOK_KEEP_FOR_DAYS=1
GENLOOK_TIMEOUT_SECONDS=120

# ==============================================================================
# Local Vision & Admin AI Models (chạy trên GPU server; KHÔNG dùng OOTDiffusion)
# Với real: AI_MODE=real, EMBEDDED_WORKER=false; worker chạy process riêng.
# ==============================================================================
VISION_DEVICE=cuda
DEEPFASHION_WEIGHTS=./weights/deepfashion2_yolov8s-seg.pt
POSE_WEIGHTS=./weights/yolo26s-pose.pt
SAM2_WEIGHTS=./weights/sam2/sam2.1_l.pt
VLM_MODEL_DIR=./api/models/vlm/Qwen3-VL-4B-Instruct
ENABLE_SAM2=true
ENABLE_VLM=true
HF_HOME=./.cache/huggingface
HF_TOKEN=
DEEPFASHION_REPO_ID=Bingsu/adetailer
DEEPFASHION_REVISION=main

# Compose mount host -> /app/...; không dùng path Windows bên trong container.
AI_BIND_HOST=127.0.0.1
AI_HOST_PORT=8000
HOST_RUNTIME_DIR=./data/runtime
HOST_WEIGHTS_DIR=./weights
HOST_HF_CACHE_DIR=./.cache/huggingface
GPU_DEVICE_ID=0

# Dùng bởi script SSH hướng dẫn trong StepByStepToRunGPUFromTwoIDE.md
GPU_SSH_HOST=CHANGE_ME_HOST
GPU_SSH_PORT=22
GPU_SSH_USER=CHANGE_ME_USER
GPU_SSH_KEY_PATH=C:/Users/KHANH/.ssh/yofaso_gpu
GPU_LOCAL_FORWARD_PORT=18000
GPU_REMOTE_API_PORT=8000
