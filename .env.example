# Copy thành .env và tự tạo secret; không commit file .env thật.
AI_INTERNAL_API_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_ENV=development
AI_MODE=mock
EMBEDDED_WORKER=true
EXPOSE_DOCS=true
RUNTIME_DIR=./data/runtime
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
MIN_IMAGE_SIDE=128
MAX_QUEUE_SIZE=20
RATE_LIMIT_PER_MINUTE=120
MAX_JOB_ATTEMPTS=2
JOB_TIMEOUT_SECONDS=300
RETENTION_HOURS=24
MOCK_PERSON_FRAME=full_body
MOCK_CATEGORY=upper_body
# Với real: AI_MODE=real, EMBEDDED_WORKER=false; worker chạy process riêng.
VISION_DEVICE=cpu
OOTD_ROOT=./api/models/ootdiffusion
DEEPFASHION_WEIGHTS=./weights/deepfashion2_yolov8s-seg.pt
POSE_WEIGHTS=./weights/yolo26s-pose.pt
HF_HOME=./.cache/huggingface
HF_TOKEN=
OOTD_REPO_ID=levihsu/OOTDiffusion
OOTD_REVISION=main
DEEPFASHION_REPO_ID=Bingsu/adetailer
DEEPFASHION_REVISION=main
# Compose mount host -> /app/...; không dùng path Windows bên trong container.
AI_BIND_HOST=127.0.0.1
AI_HOST_PORT=8000
HOST_RUNTIME_DIR=./data/runtime
HOST_OOTD_DIR=./api/models/ootdiffusion
HOST_WEIGHTS_DIR=./weights
HOST_HF_CACHE_DIR=./.cache/huggingface
GPU_DEVICE_ID=0
# Dùng bởi script SSH hướng dẫn trong setupGuide, không phải quyền API nhà thuê.
GPU_SSH_HOST=CHANGE_ME_HOST
GPU_SSH_PORT=22
GPU_SSH_USER=CHANGE_ME_USER
GPU_SSH_KEY_PATH=C:/Users/KHANH/.ssh/yofaso_gpu
GPU_LOCAL_FORWARD_PORT=18000
GPU_REMOTE_API_PORT=8000
