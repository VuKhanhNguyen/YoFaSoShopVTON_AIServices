FROM python:3.10-slim-bookworm
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt && pip check
COPY api /app/api
COPY workers /app/workers
RUN mkdir -p /app/data/runtime /app/.cache && chown -R 10001:10001 /app/data /app/.cache
ENV HOME=/app XDG_CACHE_HOME=/app/.cache YOLO_CONFIG_DIR=/app/.cache/ultralytics
USER 10001:10001
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
